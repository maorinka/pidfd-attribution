[Unit]
Description=pidfd-attribution module-free endpoint sensor
After=local-fs.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 /opt/pidfd-endpoint/python/service.py run --config /etc/pidfd-endpoint.json
Restart=always
RestartPreventExitStatus=2 78
RestartSec=10
TimeoutStartSec=180
TimeoutStopSec=30
WatchdogSec=30
User=root
Group=root
UMask=0077
StateDirectory=pidfd-endpoint
StateDirectoryMode=0700
WorkingDirectory=/opt/pidfd-endpoint/build
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_BPF CAP_PERFMON CAP_SYS_RESOURCE CAP_DAC_READ_SEARCH
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/pidfd-endpoint
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
ProtectHostname=true
MemoryDenyWriteExecute=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
SystemCallFilter=~@mount @reboot @swap @obsolete @cpu-emulation
SystemCallErrorNumber=EPERM
IPAddressDeny=any
RestrictNamespaces=true
RestrictSUIDSGID=true
PrivateDevices=true
ProtectProc=invisible
LimitNOFILE=1024
MemoryMax=512M
TasksMax=32

[Install]
WantedBy=multi-user.target
